#!/usr/bin/env bash
# sb: open the second brain.
#
# On the machine that holds the data (the M3: ~/query_graph.py + ~/knowledge_base) this
# starts nvim in the secondbrain dir. On any other machine it opens the same thing on
# the M3 over SSH, so there is one front end and it always reads live data.
#
#   sb            local if the data is here, else SSH to the M3 (the full front end)
#   sb --local    nvim on this machine in client mode: verbs run on the M3 over SSH,
#                 Claude runs here (no keychain unlock), KB files are not available
#
# Opens on :KBHome (today's brief with the slip-zone queue under it) so the daily pass
# starts the moment nvim does.
#
# Override the host with $SECONDBRAIN_HOST, the dir with $SECONDBRAIN.
set -euo pipefail

host="${SECONDBRAIN_HOST:-eoin@100.103.128.44}"
dir="${SECONDBRAIN:-$HOME/Documents/secondbrain}"

has_data() { [[ -r "$HOME/query_graph.py" && -d "$HOME/knowledge_base" ]]; }

if [[ "${1:-}" != "--local" ]] && ! has_data; then
  exec ssh -t -o ConnectTimeout=10 "$host" '~/.local/bin/sb'
fi

[[ -d "$dir" ]] || { echo "sb: no such dir: $dir (set \$SECONDBRAIN to override)" >&2; exit 1; }
cd "$dir"
if [[ "${1:-}" == "--local" ]] && ! has_data; then
  exec nvim +KBHome   # client mode
fi
if has_data; then
  # Over SSH the login keychain is locked (secrets unreadable, exit 36), and Claude Code
  # keeps its login there, so :KBAsk/:KBDraft would fail with "Not logged in". Unlock it
  # once per session; the prompt is the Mac login password.
  if [[ -n "${SSH_CONNECTION:-}" ]] \
    && ! security find-generic-password -s "Claude Code-credentials" -w >/dev/null 2>&1; then
    echo "sb: unlocking the login keychain for this SSH session (Claude Code's login lives there)."
    security unlock-keychain "$HOME/Library/Keychains/login.keychain-db" \
      || echo "sb: keychain still locked; :KBAsk and :KBDraft will not authenticate in this session." >&2
  fi
  exec nvim +KBHome
fi
exec nvim
